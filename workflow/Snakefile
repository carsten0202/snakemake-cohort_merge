from pathlib import Path

from snakemake.utils import min_version, validate


min_version("9.9.0")

configfile: "config/defaults.yaml"

validate(config, "schemas/config.schema.yaml")

CHROMOSOMES = config["chromosomes"]
COHORTS = list(config["cohorts"])
EXCLUSION_COHORTS = [
    cohort
    for cohort in COHORTS
    if "exclude_samples" in config["cohorts"][cohort]
]
HAS_SAMPLE_EXCLUSIONS = bool(EXCLUSION_COHORTS)
DEDUPLICATION_ENABLED = config["deduplication"]["enabled"]
if DEDUPLICATION_ENABLED:
    priorities = [config["cohorts"][cohort].get("priority") for cohort in COHORTS]
    if any(priority is None for priority in priorities):
        raise WorkflowError("Deduplication requires a priority for every cohort")
    if len(set(priorities)) != len(priorities):
        raise WorkflowError("Deduplication requires unique cohort priorities")

SUPER_COHORT = config["super_cohort"]
OUTPUT_DIRECTORY = str(Path(config["output_directory"]) / SUPER_COHORT)

FINAL_VCF = str(Path(OUTPUT_DIRECTORY) / f"{SUPER_COHORT}.vcf.gz")

ANALYSIS_DIRECTORY = Path(OUTPUT_DIRECTORY) / "analysis"
PLINK_PREFIX = str(ANALYSIS_DIRECTORY / "plink" / SUPER_COHORT)
PCAIR_PREFIX = str(ANALYSIS_DIRECTORY / "pcair" / SUPER_COHORT)
RELATEDNESS_REPORT = f"{PCAIR_PREFIX}.related_pairs.tsv"
DEDUPLICATED_VCF = str(Path(OUTPUT_DIRECTORY) / f"{SUPER_COHORT}.deduplicated.vcf.gz")
DEDUPLICATION_DIRECTORY = Path(OUTPUT_DIRECTORY) / "qc" / "deduplication"
SAMPLE_MANIFEST = str(DEDUPLICATION_DIRECTORY / "sample_manifest.tsv")
DUPLICATE_PAIRS = str(DEDUPLICATION_DIRECTORY / "duplicate_pairs.tsv")
SAMPLE_DECISIONS = str(DEDUPLICATION_DIRECTORY / "sample_decisions.tsv")
DUPLICATE_REMOVALS = str(DEDUPLICATION_DIRECTORY / "removed_samples.txt")
DEDUPLICATION_OUTPUTS = (
    [DEDUPLICATED_VCF, f"{DEDUPLICATED_VCF}.tbi", SAMPLE_MANIFEST,
     DUPLICATE_PAIRS, SAMPLE_DECISIONS, DUPLICATE_REMOVALS]
    if DEDUPLICATION_ENABLED else []
)

PLINK_OUTPUTS = [
    f"{PLINK_PREFIX}.bed",
    f"{PLINK_PREFIX}.bim",
    f"{PLINK_PREFIX}.fam",
    f"{PLINK_PREFIX}.log",
]

PCAIR_OUTPUTS = [
    f"{PCAIR_PREFIX}.gds",
    f"{PCAIR_PREFIX}.KINGkinship.png",
    f"{PCAIR_PREFIX}.KINGkinship.tsv",
    f"{PCAIR_PREFIX}.ldprune.snpids.txt",
    f"{PCAIR_PREFIX}.eigenvalues.tsv",
    f"{PCAIR_PREFIX}.eigenvectors.tsv",
    f"{PCAIR_PREFIX}.pcair_1v2.png",
    f"{PCAIR_PREFIX}.pcair_3v4.png",
    f"{PCAIR_PREFIX}.pcrelate.RData",
    f"{PCAIR_PREFIX}.pcrelate_1v2.png",
]


rule all:
    input:
        FINAL_VCF,
        f"{FINAL_VCF}.tbi",
        PLINK_OUTPUTS,
        PCAIR_OUTPUTS,
        RELATEDNESS_REPORT,
        DEDUPLICATION_OUTPUTS,


include: "rules/bcftools.smk"
include: "rules/pcair.smk"
include: "rules/deduplication.smk"
